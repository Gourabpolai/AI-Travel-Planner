# TripSync Client Environment Configuration
# Note: Google Maps / Places API keys are securely held and proxied by the backend server.

# Production Domain / Canonical Origin (Optional, defaults to window.location.origin in browser)
# VITE_SITE_URL=https://tripsync.app

# Backend API Base URL
# - Required when frontend & backend are deployed to separate domains (e.g. Vercel + Render).
#   Example: VITE_API_URL=https://api.yourdomain.com (or https://tripsync-backend.onrender.com)
# - Optional when frontend and backend share the same origin / reverse proxy: defaults to /api in production.
# - In local development: defaults to http://localhost:8000/api when omitted.
# VITE_API_URL=https://api.yourdomain.com
