# ==============================================================================
# TripSync Server Environment Configuration (Production Template)
# ==============================================================================
# Copy this file to .env and replace placeholder values with real credentials.
# NEVER commit .env to version control.
# ==============================================================================

# Server Runtime
PORT=8000
NODE_ENV=production

# Reverse Proxy Trust (Required when deployed behind AWS ALB, Render, Heroku, Nginx, Cloudflare)
# Set to "1" (single-hop proxy), "true", or number of proxy hops. Leave unset for direct connections.
# TRUST_PROXY=1

# MongoDB Atlas Connection
# Required in production. Must be a valid MongoDB Atlas connection string.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/tripsync?retryWrites=true&w=majority
# DB_NAME=tripsync

# For Local Development MongoDB fallback only:
# MONGO_URI=mongodb://127.0.0.1:27017/tripsync

# JWT Secret for Session Authentication & Token Signing
# Required in production. Generate a strong 32+ character random string.
JWT_SECRET=<strong-random-32-char-production-secret>

# Production Domain / Canonical Origin (Used for Sitemap XML & Robots.txt generation)
SITE_URL=https://tripsync.app

# Cross-Origin Resource Sharing (CORS)
# Comma-separated list of allowed frontend origins in production.
# Example: CORS_ORIGIN=https://tripsync.app,https://www.tripsync.app
CORS_ORIGIN=https://tripsync.app

# Google Gemini AI API Key (Backend-only)
# Required for AI itinerary generation and travel summaries.
GEMINI_API_KEY=<your-google-gemini-api-key>

# Google Places API Key (Backend-only)
# Required for real place searches, autocomplete, and details.
GOOGLE_PLACES_API_KEY=<your-google-places-api-key>
# Optional: separate key for photo proxy requests (defaults to GOOGLE_PLACES_API_KEY if omitted)
# GOOGLE_PLACES_PHOTO_API_KEY=<your-google-places-photo-key>

# Google Places Cache TTL in seconds (Default: 86400 = 24 hours)
GOOGLE_PLACES_CACHE_TTL=86400

# Geoapify API Key (Optional location fallback)
# GEOAPIFY_API_KEY=<your-geoapify-key>

# SMTP Email Configuration (Optional - for registration/verification emails)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=<your-email>@gmail.com
# SMTP_PASS=<your-app-password>

# Rate Limiting Bypass (FOR AUTOMATED TESTING ONLY - DO NOT SET TO TRUE IN PRODUCTION)
# DISABLE_RATE_LIMIT=false
